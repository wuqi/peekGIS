# peekGIS desktop entry template (Linux).
# Install: copy to ~/.local/share/applications/peekGIS.desktop after editing the two
# <REPLACE> lines. A concrete .desktop is also generated by xmake into the build
# release root (build/linux/x86_64/release/peekGIS.desktop) with absolute paths.
[Desktop Entry]
Type=Application
Name=peekGIS
Comment=GIS raster/vector viewer (GDAL)
Exec=<REPLACE>/build/linux/x86_64/release/bin/peekgis
Icon=<REPLACE>/build/linux/x86_64/release/bin/assets/layer-group-solid.png
Terminal=false
Categories=Science;Geoscience;Graphics;